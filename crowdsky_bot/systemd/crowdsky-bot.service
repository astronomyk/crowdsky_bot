[Unit]
Description=CrowdSky Bot — auto stack-and-upload for Seestar
After=network-online.target time-sync.target
Wants=network-online.target

[Service]
Type=simple
# WorkingDirectory is the uv project that has crowdsky-bot installed.
WorkingDirectory=%h/crowdsky_service
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/uv run crowdsky-bot serve
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
